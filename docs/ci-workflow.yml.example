# Copy to .github/workflows/ci.yml to activate GitHub Actions.
name: Verify
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.4.2
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm install --global opencode-ai@1.18.34
      - run: bun install --frozen-lockfile
      - run: bunx playwright install --with-deps chromium
      - run: bun run typecheck
      - run: bun test
      - run: bun run build
      - run: EMAIL_SYNC_BUILT_TEST=1 bun test test/e2e/persistence.test.ts
      - run: EMAIL_SYNC_BUILT_TEST=1 bun test test/e2e/permissions.test.ts

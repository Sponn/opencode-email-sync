{
  "name": "opencode-email-sync",
  "version": "0.3.0",
  "type": "module",
  "description": "Two-way email participation in OpenCode sessions",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Sponn/opencode-email-sync.git" },
  "engines": { "bun": ">=1.4.2" },
  "exports": { ".": "./dist/index.js" },
  "bin": { "opencode-email-sync": "./dist/cli.js" },
  "files": ["dist", "examples", "README.md", "LICENSE", "docs/configuration.md", "docs/operations.md", "docs/persistence.md", "docs/permissions.md"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts src/cli.ts --target=bun --outdir=dist --external=@opencode-ai/plugin --external=@opencode-ai/sdk"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opencode-ai/sdk": "1.18.34",
    "dotenv": "^16.6.1",
    "jsonc-parser": "^3.3.1",
    "imapflow": "^1.0.195",
    "mailparser": "^3.7.4",
    "marked": "^16.3.0",
    "nodemailer": "^7.0.6",
    "sanitize-html": "^2.17.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "@types/bun": "^1.3.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.1",
    "@types/sanitize-html": "^2.16.0",
    "smtp-server": "^3.15.0",
    "@types/smtp-server": "^3.5.12",
    "typescript": "^5.8.2"
  }
}
